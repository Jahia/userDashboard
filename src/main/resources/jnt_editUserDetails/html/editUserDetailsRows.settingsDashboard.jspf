<%--
  One mount point per section. A section's surface, its title and its edit button are
  drawn by Moonstone on the React side (see PrivateSection.jsx), so there is no card
  markup here any more - these ids are the whole contract.
--%>
<div class="ud-edit-sectionWrap">
    <div id="aboutRows" class="ud-edit-sectionGrid">
        <div id="editUserDetailsPrivateHeroRoot"></div>
    </div>
</div>

<div class="ud-edit-sectionWrap">
    <div id="userDetailsRow" class="ud-edit-sectionGrid">
        <div id="editUserDetailsPrivateIdentityRoot"></div>
    </div>
</div>

<div class="ud-edit-sectionWrap">
    <div id="AddressRows" class="ud-edit-sectionGrid">
        <div id="editUserDetailsPrivateContactRoot"></div>
    </div>
</div>

<div class="ud-edit-sectionWrap">
    <div id="passwordRows" class="ud-edit-sectionGrid">
        <div id="editUserDetailsPrivatePasswordRoot"></div>
    </div>
</div>

<div class="ud-edit-sectionWrap">
    <div id="otherRows" class="ud-edit-sectionGrid">
        <div id="editUserDetailsPrivatePreferencesRoot"></div>
    </div>
</div>
