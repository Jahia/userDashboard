<template:addResources>
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
        });
    </script>
</template:addResources>

<div id="iconView" class="ud-list-surface">
        <%@include file="myFilesDashboard.settingsDashboard.folder-toolbarBreadcrumb.jspf" %>
    <fmt:message key="label.delete" var="deleteLabel"/>
    <fmt:message key="label.rename" var="renameLabel"/>

        <div id="carouselView" class="ud-myFiles-slider" data-current-index="0">
                <c:set value="${0}" var="index"/>
                <c:if test="${not empty folderNode}">
                    <c:forEach items="${jcr:getChildrenOfType(folderNode,'jnt:file')}" var="node" varStatus="status">
                        <c:if test="${(fn:split(node.fileContent.contentType, '/')[0]) eq 'image'}">
                            <div class="ud-myFiles-slide${index eq 0 ? ' is-active' : ''}">
                                <div class="ud-myFiles-slide__media">
                                    <img src="<c:url value='${url.files}${functions:escapePath(node.path)}'/>"
                                         width="${node.properties['j:width'].string}"
                                         height="${node.properties['j:height'].string}" alt="${node.name}"/>
                                </div>
                                <div class="ud-myFiles-slide__caption">
                                    <div class="ud-myFiles-slide__actions">
                                        <a class="ud-list-iconLink" href="#" title="${fn:escapeXml(deleteLabel)}" aria-label="${fn:escapeXml(deleteLabel)}"
                                           onclick="bbDelete('${functions:escapeJavaScript(node.name)}' ,'${functions:escapeJavaScript(node.identifier)}' );return false;">
                                            <img src="<c:url value='${url.currentModule}/img/delete.svg'/>" alt="${fn:escapeXml(deleteLabel)}" width="24" height="24"/>
                                        </a>
                                        <a class="ud-list-iconLink" href="#" title="${fn:escapeXml(renameLabel)}" aria-label="${fn:escapeXml(renameLabel)}"
                                           onclick="editInContentEditor('${functions:escapeJavaScript(node.identifier)}', '${functions:escapeJavaScript(currentResource.locale)}', '${functions:escapeJavaScript(renderContext.UILocale)}', '${functions:escapeJavaScript(node.resolveSite.name)}');return false">
                                            <img src="<c:url value='${url.currentModule}/img/edit.svg'/>" alt="${fn:escapeXml(renameLabel)}" width="24" height="24"/>
                                        </a>
                                        <a class="ud-list-iconLink"
                                           href="<c:url value='${url.files}${functions:escapePath(node.path)}'/>"
                                           title="<fmt:message key="label.download"/>"
                                           download>
                                            <i class="material-icons">file_download</i>
                                        </a>
                                    </div>
                                    <h3>${node.name}</h3>
                                    <p>
                                        <fmt:message
                                                key="label.size"/>&nbsp;:&nbsp;${functions:humanReadableByteCount(node.fileContent.contentLength)}
                                        <br/>
                                        <fmt:message
                                                key="myFiles.dimension"/>&nbsp;:&nbsp;${node.properties['j:width'].string}x${node.properties['j:height'].string}
                                    </p>
                                </div>
                            </div>
                            <c:set value="${index + 1}" var="index"/>
                        </c:if>
                    </c:forEach>
                </c:if>
                <c:if test="${index eq 0}">
                    <div class="ud-myFiles-slide is-active">
                        <div class="ud-myFiles-emptyState">
                            <fmt:message key="myFiles.slideView.noImage"/>
                        </div>
                    </div>
                </c:if>
            <c:if test="${index gt 1}">
                <div class="ud-myFiles-sliderNav">
                    <button class="ud-list-button" type="button" onclick="myFilesSliderStep('carouselView', -1)">
                        <i class="material-icons">keyboard_arrow_left</i>
                    </button>
                    <button class="ud-list-button" type="button" onclick="myFilesSliderStep('carouselView', 1)">
                        <i class="material-icons">keyboard_arrow_right</i>
                    </button>
                </div>
            </c:if>
        </div>
</div>

